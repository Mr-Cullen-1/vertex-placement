# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the running app (src/lib/db.ts).
# Against Supabase, use the Transaction Pooler connection string (port
# 6543) — the app should never hold long-lived direct connections. For a
# plain local/self-hosted Postgres, the direct connection is fine here.
DATABASE_URL="postgresql://user:password@localhost:5432/vertex_placement?schema=public"

# Connection string used ONLY by the Prisma CLI (migrate/db seed/studio —
# see prisma.config.ts). Against Supabase, use the Direct connection
# string (port 5432), not the pooler — migrations run DDL and (for
# `migrate dev`) need a shadow database, neither of which a
# transaction-mode pooler reliably supports. For local/self-hosted
# Postgres this can be the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/vertex_placement?schema=public"

# Auth.js secret — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# Public base URL of this deployment, used to build student invitation links
# such as https://placement.vertexquiz.com/placement/{token}.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: bootstraps the first Super Admin when `npm run db:seed` is run.
# Leave unset after the first run.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_NAME="Super Admin"

# Optional: also seeds a small, clearly-marked DEVELOPMENT-ONLY sample
# placement test (never the real Macmillan content). Refused when
# NODE_ENV=production. See docs/PHASE_1.md.
SEED_DEV_SAMPLE_TEST=""

# --- Phase 2J: public self-service ("Try Yourself") ---
# See /docs/PHASE_2J_TRY_YOURSELF.md for the full design. All three are
# optional and read directly (not through the strict src/lib/env.ts
# schema) — a deployment without them still boots; it just shows a
# controlled "not available" state instead of failing.

# Resend (https://resend.com) API key, used to email verification codes.
# If unset, the console dev-only provider is used instead (logs the code
# to the SERVER console — never the browser — and refuses to run at all
# when NODE_ENV=production, so this can never silently become the
# effective provider in production).
RESEND_API_KEY=""

# "From" address for verification-code emails. Must be a domain verified
# with Resend in production; Resend's own onboarding@resend.dev sender
# works for testing without any domain setup.
RESEND_FROM_EMAIL="Vertex Placement <onboarding@resend.dev>"

# Shown as the "Contact administrator" action once a visitor has used
# both free Try Yourself attempts. Public (safe to expose to the
# browser). Leave unset to degrade gracefully — the UI simply omits the
# contact button rather than showing a fake address.
NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=""

# --- Not used yet — reserved for future phases, see /docs/ARCHITECTURE.md ---
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_GROUP_CHAT_ID=""
